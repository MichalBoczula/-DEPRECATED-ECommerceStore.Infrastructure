# Non-secret configuration only. Copy to development.auto.tfvars if needed.
# D/6 checks Free eligibility; D/7 configures access; D/9 verifies app compatibility.
location    = "northeurope"
name_prefix = "ecommerce"
tags = {
  owner = "portfolio"
}

# Default-off D/7; follow docs/development-network-access.md for staged activation.
enable_shared_environment = false
enable_database_access    = false
# database_aca_ipv4 comes from the ignored discovery file, never a workstation IP.

# D/8 business storage/vault; requires the shared ACA subnet.
# Use docs/development-data-services.md with the same local lifecycle script.
enable_data_services = false
